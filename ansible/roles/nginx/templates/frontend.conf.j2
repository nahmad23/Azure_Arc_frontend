# {{ ansible_managed }}
{# nginx drops server-level add_header in any location that sets its own,
    so the common headers are repeated wherever a location adds one. -#}
{% set common_headers %}
add_header X-Served-By {{ inventory_hostname }} always;
add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options SAMEORIGIN always;
{% if nginx_tls_enabled | bool %}
add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
{% endset %}
{% if backend_servers | length > 0 %}
upstream frontend_backend {
{% for server in backend_servers %}
    server {{ server }} max_fails=3 fail_timeout=10s;
{% endfor %}
    keepalive 32;
}

{% endif %}
{% if nginx_tls_enabled | bool %}
server {
    listen 80 default_server;
{% if nginx_listen_ipv6 | bool %}
    listen [::]:80 default_server;
{% endif %}
    server_name {{ nginx_server_name }};
    server_tokens off;
    add_header X-Served-By {{ inventory_hostname }} always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok {{ inventory_hostname }}\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% endif %}
server {
{% if nginx_tls_enabled | bool %}
    listen 443 ssl http2 default_server;
{% if nginx_listen_ipv6 | bool %}
    listen [::]:443 ssl http2 default_server;
{% endif %}
    ssl_certificate     {{ nginx_tls_dir }}/frontend.crt;
    ssl_certificate_key {{ nginx_tls_dir }}/frontend.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
{% else %}
    listen 80 default_server;
{% if nginx_listen_ipv6 | bool %}
    listen [::]:80 default_server;
{% endif %}
{% endif %}
    server_name {{ nginx_server_name }};

    root  {{ nginx_web_root }};
    index index.html;

    server_tokens off;
    {{ common_headers | trim | indent(4) }}

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Used by keepalived and load balancers to check this node.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok {{ inventory_hostname }}\n";
    }

{% if backend_servers | length > 0 %}
    location {{ backend_location }} {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

{% endif %}
{% if portal_enabled | default(false) | bool %}
    # Provisioning portal (FastAPI) running on this node.
    location / {
        proxy_pass http://127.0.0.1:{{ portal_port | default(8000) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:{{ portal_port | default(8000) }};
        expires 1h;
        {{ common_headers | trim | indent(8) }}
    }
{% else %}
    # Long-cache fingerprinted build assets.
    location ~* \.(?:js|css|png|jpe?g|gif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        {{ common_headers | trim | indent(8) }}
        try_files $uri =404;
    }

    location / {
        # Always revalidate the HTML shell so new deployments are picked up.
        add_header Cache-Control "no-cache";
        {{ common_headers | trim | indent(8) }}
{% if nginx_spa_fallback | bool %}
        try_files $uri $uri/ /index.html;
{% else %}
        try_files $uri $uri/ =404;
{% endif %}
    }
{% endif %}
}
